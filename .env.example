# ====================================================================
# OpenWrt 流量统计 - 环境变量配置(用户复制为 .env 后修改)
#
# cp .env.example .env
# vim .env
# docker compose up -d
# ====================================================================

# ----- 路由器 SSH(必填,根据你的实际情况修改) -----
# 路由器的 LAN IP。常见网段:
#   - 192.168.1.1   (默认/普联/华为)
#   - 192.168.0.1   (D-Link/TP-Link 部分型号)
#   - 192.168.31.1  (小米)
#   - 192.168.50.1  (华硕)
#   - 192.168.2.1   (磊科/部分电信光猫后)
#   - 10.0.0.1
ROUTER_HOST=192.168.1.1
ROUTER_PORT=22
ROUTER_USER=root
ROUTER_PASSWORD=change_me_to_router_root_password

# ----- MySQL 凭证(必填,自己定密码) -----
# 首次启动 docker compose 时会用这些值自动建库 + 建账号
MYSQL_ROOT_PASSWORD=change_me_to_strong_password
MYSQL_DB=traffic_stats
MYSQL_USER=traffic
MYSQL_PASSWORD=change_me_too

# ----- Web 服务端口(宿主机访问的端口) -----
WEB_PORT=8080

# ----- 时区 -----
TZ=Asia/Shanghai

# ----- 采集器频率(秒,有合理默认值,一般无需调整) -----
INTERVAL_IFACE_SEC=60       # /proc/net/dev 接口数据
INTERVAL_NLBW_SEC=60        # nlbwmon 设备数据(改成 60 可获得分钟粒度的设备图,
                            # 代价:数据库每天多写 ~5 万行,SSD 无感)
INTERVAL_DHCP_SEC=3600      # DHCP 租约同步

# ----- 监控的接口(逗号分隔,常见:pppoe-wan, br-lan, eth0) -----
WATCH_IFACES=pppoe-wan,br-lan

# ----- 日志级别(debug/info/warn/error) -----
LOG_LEVEL=info
