{
  "name": "traffic-stats-backend",
  "version": "0.1.0",
  "private": true,
  "description": "OpenWrt traffic statistics: collector + API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "init-db": "bash scripts/init-db.sh"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/ssh2": "^1.15.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
